      "seed": 1306635,
      "version": 1,
      "versionNonce": 218955,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792540800000,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "• H v1.2/01: solo gerente de origen rechaza con motivo desde «en preparación», antes de aprobar; sin efectos en stock o tránsito.",
      "originalText": "• H v1.2/01: solo gerente de origen rechaza con motivo desde «en preparación», antes de aprobar; sin efectos en stock o tránsito.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "transferencia-166",
      "type": "text",
      "x": 125,
      "y": 8740.0,
      "width": 2820,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
