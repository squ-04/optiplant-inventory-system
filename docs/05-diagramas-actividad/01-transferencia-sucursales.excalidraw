      "isDeleted": false,
      "boundElements": [],
      "updated": 1792540800000,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "• Rechazo de negocio, cancelación y validación fallida son distintos; un intento denegado conserva el estado previo.",
      "originalText": "• Rechazo de negocio, cancelación y validación fallida son distintos; un intento denegado conserva el estado previo.",
      "textAlign": "left",
