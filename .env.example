# Plantilla documental: genera valores individuales con python3 scripts/init_environment.py.
# No utilizar estos marcadores como credenciales reales.
POSTGRES_DB=optiplant
POSTGRES_USER=optiplant_owner
POSTGRES_PASSWORD=REPLACE_WITH_INDIVIDUAL_SECRET
APP_DB_PASSWORD=REPLACE_WITH_RUNTIME_INDIVIDUAL_SECRET
APP_DB_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_INDIVIDUAL_SECRET
APP_ADMIN_CODE=ADMIN
APP_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_INDIVIDUAL_SECRET
APP_DEMO_DATA=true
BACKEND_PORT=8080
FRONTEND_PORT=5173
